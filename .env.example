# Salin file ini menjadi .env lalu isi API key dari Settings di kripicard.com.
# .env tidak ikut ke-commit (ada di .gitignore).
KRIPICARD_API_KEY=

# Opsional: daftar BIN kalau KripiCard menggantinya lagi (pisahkan dengan koma).
# Default: 441357,49387520,493728,474613
# KRIPICARD_BINS=
# Opsional: BIN yang wajib tanggal lahir.
# KRIPICARD_BINS_NEED_DOB=

# Port dashboard (opsional)
PORT=3000
